rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }

    match /cheers/{cheerId} {
      // 누구나 사전예약 신청 등록 가능 (생성)
      allow create: if request.resource.data.id is string
        && request.resource.data.platform in ['모바일', 'PC']
        && request.resource.data.os is string
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 60
        && request.resource.data.marketing is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.createdAt is number;

      // 주최자/관리자 화면에서 실시간 조회, 상태 수정, 삭제 허용
      allow read, update, delete: if true;
    }
  }
}
